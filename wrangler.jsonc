{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grokbot-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "grokbot-landing-media" }
  ],
  "observability": {
    "enabled": true
  }
}
